{
  "name": "vite-react-hono-workers-template",
  "private": true,
  "description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
  "type": "module",
  "imports": {
    "#worker/*": "./src/worker/*.ts"
  },
  "scripts": {
    "api:generate": "node scripts/generate-openapi.ts && orval",
    "build": "pnpm run api:generate && pnpm run cf-typegen && tsc -b && vp build",
    "cf-typegen": "cf workers types",
    "check:deploy": "pnpm run build && cf deploy --dry-run --prebuilt",
    "check": "pnpm run api:generate && pnpm run cf-typegen && vp check",
    "deploy": "pnpm run build && cf deploy --prebuilt",
    "dev": "pnpm run api:generate && cf dev",
    "fmt:check": "vp fmt --check",
    "fmt": "vp fmt",
    "lint:fix": "vp lint --fix",
    "lint": "vp lint",
    "preview": "pnpm run build && vp preview",
    "test:coverage": "vp test run --coverage && pnpm run test:worker:native",
    "test:watch": "vp test",
    "test": "vp test run && pnpm run test:worker:native",
    "test:smoke": "playwright test",
    "test:worker:native": "node --test scripts/worker-native.test.ts"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.1",
    "hono": "4.13.14",
    "hono-openapi": "^1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "^2.5.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.6",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "cf": "^1.0.0-beta.24",
    "jsdom": "^30.1.3",
    "orval": "^8.45.0",
    "typescript": "7.0.2",
    "ultracite": "^8.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": "^24.22.0 || >=26.12.0"
  },
  "packageManager": "pnpm@12.15.0",
  "cloudflare": {
    "label": "Vite React Hono Workers Template",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
    "publish": true
  }
}
