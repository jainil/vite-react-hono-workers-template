{
  "name": "vite-react-hono-workers-template",
  "private": true,
  "description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
  "type": "module",
  "scripts": {
    "api:generate": "TSX_TSCONFIG_PATH=tsconfig.codegen.json node --import tsx scripts/generate-openapi.ts && orval",
    "build": "pnpm run api:generate && pnpm run cf-typegen && tsc -b && vp build",
    "cf-typegen": "cf workers types",
    "check:deploy": "pnpm run build && cf deploy --dry-run --prebuilt",
    "check": "pnpm run api:generate && pnpm run cf-typegen && vp check",
    "deploy": "pnpm run build && cf deploy --prebuilt",
    "dev": "pnpm run api:generate && cf dev",
    "fmt:check": "vp fmt --check",
    "fmt": "vp fmt",
    "lint:fix": "vp lint --fix",
    "lint": "vp lint",
    "preview": "pnpm run build && vp preview",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test",
    "test": "vp test run"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "hono": "4.13.13",
    "hono-openapi": "^1.3.5",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "swr": "^2.5.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "cf": "^1.0.0-beta.18",
    "jsdom": "^30.1.3",
    "orval": "^8.43.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "ultracite": "^8.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.4.2",
  "cloudflare": {
    "label": "Vite React Hono Workers Template",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
    "publish": true
  }
}
